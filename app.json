{
  "expo": {
    "name": "Ascend",
    "slug": "ascend-electric",
    "version": "2.8.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.ascend.electric",
      "versionCode": 13,
      "adaptiveIcon": {
        "foregroundImage": "./assets/ascend-icon.png",
        "backgroundColor": "#0B110A"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Ascend to choose a custom background photo."
        }
      ],
      [
        "expo-awesome-app-icon",
        {
          "icons": {
            "sunny-sprite": {
              "android": {
                "image": "./assets/mascots/sunny-sprite.png",
                "backgroundColor": "#141019"
              }
            },
            "mono-peek": {
              "android": {
                "image": "./assets/mascots/mono-peek.png",
                "backgroundColor": "#141019"
              }
            },
            "red-cat": {
              "android": {
                "image": "./assets/mascots/red-cat.png",
                "backgroundColor": "#141019"
              }
            },
            "sleepy-cat": {
              "android": {
                "image": "./assets/mascots/sleepy-cat.png",
                "backgroundColor": "#141019"
              }
            },
            "night-watcher": {
              "android": {
                "image": "./assets/mascots/night-watcher.png",
                "backgroundColor": "#141019"
              }
            },
            "ink-emblem": {
              "android": {
                "image": "./assets/mascots/ink-emblem.png",
                "backgroundColor": "#141019"
              }
            },
            "yin-yang": {
              "android": {
                "image": "./assets/mascots/yin-yang.png",
                "backgroundColor": "#141019"
              }
            }
          }
        }
      ]
    ],
    "icon": "./assets/ascend-icon.png",
    "splash": {
      "image": "./assets/ascend-icon.png",
      "backgroundColor": "#0B110A",
      "resizeMode": "contain"
    }
  }
}
