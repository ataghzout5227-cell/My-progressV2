{
  "expo": {
    "name": "Ascend",
    "slug": "ascend-electric",
    "version": "2.8.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.ascend.electric",
      "versionCode": 14,
      "adaptiveIcon": {
        "foregroundImage": "./assets/ascend-icon.png",
        "backgroundColor": "#0B110A"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Ascend to choose a custom background photo."
        }
      ],
      [
        "expo-awesome-app-icon",
        {
          "icons": {
            "black-bolt": {
              "android": {
                "image": "./assets/mascots/black-bolt.png",
                "backgroundColor": "#FAFAFA"
              }
            },
            "white-bolt": {
              "android": {
                "image": "./assets/mascots/white-bolt.png",
                "backgroundColor": "#111111"
              }
            },
            "golden-bolt": {
              "android": {
                "image": "./assets/mascots/golden-bolt.png",
                "backgroundColor": "#FBFBFB"
              }
            },
            "ghost-flame": {
              "android": {
                "image": "./assets/mascots/ghost-flame.png",
                "backgroundColor": "#101010"
              }
            }
          }
        }
      ]
    ],
    "icon": "./assets/ascend-icon.png",
    "splash": {
      "image": "./assets/ascend-splash.png",
      "backgroundColor": "#101010",
      "resizeMode": "contain"
    }
  }
}
